# Kinexy - producción
NODE_ENV=production
PORT=8000
FRONTEND_URL=https://kinexy.grupoamayo.com
PUBLIC_BASE_URL=https://kinexy.grupoamayo.com

# OBLIGATORIO: generar un valor aleatorio de 64+ caracteres en la VPS.
JWT_SECRET=REEMPLAZAR_EN_LA_VPS_CON_OPENSSL_RAND_HEX_64
JWT_EXPIRES_IN=7d

# PostgreSQL local en la VPS. Reemplazar USUARIO/CONTRASENA si se usan otros valores.
DATABASE_URL=postgresql://kinexy:REEMPLAZAR_PASSWORD_DB@127.0.0.1:5432/kinexy
PGSSL=false

# Archivos subidos
UPLOAD_DIR=/www/wwwroot/kinexy/backend/uploads
MAX_FILE_SIZE=8388608

# Google OAuth. El frontend ya fue compilado con este Client ID.
GOOGLE_CLIENT_ID=833887082629-5apktee9ltdbvjsblegr689olfn1ts2a.apps.googleusercontent.com

# Propietario protegido: siempre será superadmin y no podrá eliminarse ni degradarse.
OWNER_SUPERADMIN_EMAIL=mjhossephy@gmail.com

# Se usa SOLO en el primer arranque cuando la base está vacía.
BOOTSTRAP_ADMIN_EMAIL=mjhossephy@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_UNICO_DE_12_O_MAS

# Activación temporal de creadores
CREATOR_ACTIVATION_FREE=true

# Beta temporal: perfiles, publicaciones, fotos y contacto sin cobro.
# El aporte para abrir chats sigue usando tokens.
BETA_FREE_ACCESS=true

# Precios opcionales para recargas manuales Yape
# YAPE_PRICE_40=
# YAPE_PRICE_80=
# YAPE_PRICE_180=
# YAPE_PRICE_460=
